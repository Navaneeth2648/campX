# ---- Database (Supabase / Neon / Vercel Postgres / local Postgres) ----
# Copy this file to ".env.local" for local dev, and set the same vars in Vercel.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Keep SSL on for hosted DBs (Supabase, Neon, Vercel Postgres). Set to "false"
# only for a plain local Postgres without SSL.
DATABASE_SSL=true

# Shown under "Sign in to continue to ..." on the login card. Neutral demo name.
NEXT_PUBLIC_ORG_NAME=GAYATRI EDUCATIONAL DEVELOPMENT SOCIETY
